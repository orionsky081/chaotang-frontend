#!/usr/bin/env bash
# 防复发·阶段5(2026-07-03 落地)：提交前拦冲突标记，别等 build 才发现。
# 由 scripts/install-git-hooks.sh 复制进 git hooks 目录(那里不入库，这份才是 SoT)。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# monorepo 布局下 guard 在 frontend/，独立打包布局在根 —— 取存在的那份。
if [ -f scripts/guard-conflict-markers.sh ]; then
  bash scripts/guard-conflict-markers.sh
else
  bash frontend/scripts/guard-conflict-markers.sh
fi
